# Normalise line endings: LF in the repository and in checkouts for source and scripts.
* text=auto eol=lf

# Windows-only formats that need CRLF (we do not plan to ship any; kept for safety).
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binary files: never convert
*.pdf binary
*.docx binary
*.xlsx binary
*.pptx binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.woff binary
*.woff2 binary
*.ttf binary
*.wav binary
*.mp3 binary
*.m4a binary

# Lockfiles are generated: keep diffs quiet
package-lock.json -diff
