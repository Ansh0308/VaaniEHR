# VaaniEHR asr-py configuration. Copy to .env (or run `npm run setup:env` from the repo root). Never commit .env.
ASR_PY_PORT=8000
# Must be "true": research prototype, acted/simulated data only
SIMULATED_DATA_ONLY=true

# Phase 4A. Never commit values. `npm run setup:env` generates the two secrets below and moves the vendor keys here.
# Signed token secret shared with api-node (same value in both .env files).
INTERNAL_SERVICE_SECRET=REPLACE_ME_INTERNAL_SECRET
# Encrypts stored audio (AES-256-GCM, 64 hex characters). If this key is lost, stored audio CANNOT be recovered.
AUDIO_MASTER_KEY=REPLACE_ME_AUDIO_MASTER_KEY
# Vendor keys (asr-py only): SARVAM_API_KEY=  HF_TOKEN=
# Where api-node can be reached for the consent re-check, and who may open the audio WebSocket (browser Origin)
API_NODE_URL=http://localhost:4000
ALLOWED_ORIGINS=http://localhost:5173
# Spend caps (seconds). Smoke runs are capped per run; the monthly cap stops all paid-engine requests.
ASR_SMOKE_MAX_SECONDS=300
ASR_MONTHLY_CAP_MINUTES=300
# Audio retention in days (NFR-PRIV-01 assumption) and where encrypted audio and the usage log live (git-ignored data/)
AUDIO_RETENTION_DAYS=90
