# VaaniEHR api-node configuration. Copy to .env (or run `npm run setup:env` from the repo root,
# which generates random dev secrets). Never commit .env. Values below are placeholders, not secrets.

# development | test | production  (the dev auth provider is refused in production)
NODE_ENV=development
PORT=4000

# PostgreSQL 16 + pgvector (see infra/docker-compose.yml). Host port 5433 avoids clashing with a native Postgres.
# The API connects as the least-privilege role vaani_app: it can only SELECT and INSERT on the audit log and consent
# tables (no UPDATE/DELETE). The role's password is APP_DB_PASSWORD (set by `npm run db:migrate`).
DATABASE_URL=postgres://vaani_app:REPLACE_ME_APP_DB_PASSWORD@localhost:5433/vaaniehr
APP_DB_PASSWORD=REPLACE_ME_APP_DB_PASSWORD
# Owner role: used ONLY by migrations and the seed script, never by the running API.
MIGRATION_DATABASE_URL=postgres://vaani:REPLACE_ME_DB_PASSWORD@localhost:5433/vaaniehr

# Auth: "dev" = seeded fake users, own short-lived token (ADR-D4 amendment); "clinicos" = Phase 12 (stub, throws NOT_IMPLEMENTED).
AUTH_PROVIDER=dev
# VaaniEHR-only signing secret for dev tokens: at least 32 characters. Never reuse any ClinicOS secret (ADR-D4, ADR-D13).
DEV_AUTH_SECRET=REPLACE_ME_DEV_AUTH_SECRET
# Dev access-token lifetime in seconds (60..3600). No refresh token in standalone mode.
DEV_TOKEN_TTL_SECONDS=3600

# Login hardening (defaults mirror ClinicOS): per-IP rate limit and per-account lockout.
# LOGIN_RATE_LIMIT_MAX=10
# LOGIN_RATE_WINDOW_MINUTES=15
# LOCKOUT_MAX_FAILURES=5
# LOCKOUT_MINUTES=15
# bcrypt cost (default 12, minimum 10 outside tests). Set TRUST_PROXY=true only behind a reverse proxy you control.
# BCRYPT_COST=12
# TRUST_PROXY=false

# Allowed browser origin for CORS and Socket.IO
CORS_ORIGIN=http://localhost:5173

# Must be "true": research prototype, acted/simulated data only (AGENTS.md Hard Rule 1, NFR-PRIV-02)
SIMULATED_DATA_ONLY=true

# Phase 12 only (ClinicOSTokenAuth). Leave empty now.
# CLINICOS_BASE_URL=
