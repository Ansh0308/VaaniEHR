# VaaniEHR web (Vite). Only variables prefixed VITE_ are exposed to the browser: never put secrets here.

# Base URL of api-node
VITE_API_BASE_URL=http://localhost:4000

# Drives the persistent "research prototype - simulated data only" banner (AGENTS.md Hard Rule 1, NFR-PRIV-02).
# The banner is always shown; this flag must stay "true" in this research prototype.
VITE_SIMULATED_DATA_ONLY=true
