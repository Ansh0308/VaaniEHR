# --- VaaniEHR .gitignore ---
# Local tooling installed by the skills CLI / IDE (owner decision 2026-10-14)
.agents/
.claude/

# Dependencies and build output
node_modules/
dist/
build/
coverage/
*.tsbuildinfo
.vite/

# Python
.venv/
venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.mypy_cache/

# Secrets and local env (never commit; commit only *.env.example)
.env
.env.*
!.env.example

# Logs, OS and editor noise
*.log
npm-debug.log*
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json

# PRIVATE, never in git (owner decisions 2026-10-15; ADR-D18): raw or licensed downloads, recordings, benchmark audio.
# Committed seed content (NLEM CSV, pathway JSON, safety tables, golden FHIR, seed scripts) lives in seed/, which is
# tracked and must carry a source on every row. Guards: scripts/check-no-data-files.mjs, scripts/check-seed-sources.mjs.
data/
audio/
*.wav
*.mp3
*.m4a
*.webm
infra/pgdata/

# Microsoft Office lock files (created while a .docx is open in Word)
~$*

# Benchmark outputs (a small sample is tracked in bench/sample-results/)
results/
