# --- VaaniEHR .gitignore ---
# Local tooling installed by the skills CLI / IDE (owner decision 2026-10-14)
.agents/
.claude/

# Dependencies and build output
node_modules/
dist/
build/
coverage/
*.tsbuildinfo
.vite/

# Python
.venv/
venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.mypy_cache/

# Secrets and local env (never commit; commit only *.env.example)
.env
.env.*
!.env.example

# Logs, OS and editor noise
*.log
npm-debug.log*
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json

# Data and audio never go to git (owner decision 2026-10-15; enforced by scripts/check-no-data-files.mjs and CI).
# NOTE: PRD section 17 plans data/pathways, data/medicines and data/bench label files in the repo. This rule blocks
# them; a later owner decision must carve out specific paths (and update the guard) before they can be committed.
data/
audio/
*.wav
*.mp3
*.m4a
*.webm
infra/pgdata/
