{
  "name": "vaaniehr",
  "version": "0.1.0",
  "private": true,
  "description": "VaaniEHR - research prototype (simulated data only). Monorepo root.",
  "license": "UNLICENSED",
  "type": "module",
  "engines": {
    "node": ">=20.19.0"
  },
  "workspaces": [
    "apps/web",
    "apps/api-node",
    "packages/rules"
  ],
  "scripts": {
    "check": "node scripts/check.mjs",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "build": "npm run build --workspaces --if-present",
    "py:setup": "node scripts/py.mjs setup",
    "lint:py": "node scripts/py.mjs ruff",
    "test:py": "node scripts/py.mjs pytest",
    "setup:env": "node scripts/setup-env.mjs",
    "db:up": "node scripts/db.mjs up",
    "db:down": "node scripts/db.mjs down",
    "db:migrate": "node scripts/db.mjs migrate",
    "db:reset": "node scripts/db.mjs reset",
    "guard:shell": "node scripts/check-no-shell-scripts.mjs",
    "sbom": "node scripts/sbom.mjs",
    "sbom:reasons": "node scripts/sbom.mjs --reasons-only",
    "dev:api": "npm run dev -w apps/api-node",
    "dev:web": "npm run dev -w apps/web",
    "dev:asr": "node scripts/py.mjs dev"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.12.0",
    "eslint-config-prettier": "10.1.8",
    "globals": "17.13.0",
    "prettier": "3.9.10",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.2"
  }
}
