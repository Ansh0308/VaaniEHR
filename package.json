{
  "name": "vaaniehr",
  "version": "0.1.0",
  "private": true,
  "description": "VaaniEHR - research prototype (simulated data only). Monorepo root.",
  "license": "UNLICENSED",
  "type": "module",
  "engines": {
    "node": ">=20.19.0"
  },
  "workspaces": [
    "apps/web",
    "apps/api-node",
    "packages/rules"
  ],
  "scripts": {
    "check": "node scripts/check.mjs",
    "check:unit": "node scripts/check.mjs --unit",
    "a11y": "node scripts/a11y.mjs",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "test:unit": "npm run test -w apps/web && npm run test -w packages/rules && npm run test:unit -w apps/api-node",
    "coverage:api": "npm run coverage -w apps/api-node",
    "build": "npm run build --workspaces --if-present",
    "py:setup": "node scripts/py.mjs setup",
    "eval:asr": "node scripts/py.mjs exec -m app.eval",
    "usage:asr": "node scripts/py.mjs exec -m app.usage_report",
    "pathways:validate": "node --import tsx packages/rules/src/cli.ts validate",
    "pathways:lock": "node --import tsx packages/rules/src/cli.ts lock",
    "pathway:new": "node --import tsx packages/rules/src/cli.ts new",
    "pathway:version": "node --import tsx packages/rules/src/cli.ts version",
    "pathway:lint": "node --import tsx packages/rules/src/cli.ts lint",
    "pathways:coverage": "node --import tsx packages/rules/src/cli.ts coverage",
    "pathways:cases": "node --import tsx packages/rules/src/cli.ts cases",
    "eval:extraction": "node scripts/py.mjs exec -m app.eval_extraction",
    "list:simulated-text": "node scripts/py.mjs exec -m app.simulated_text list",
    "lint:py": "node scripts/py.mjs ruff",
    "test:py": "node scripts/py.mjs pytest",
    "setup:env": "node scripts/setup-env.mjs",
    "db:up": "node scripts/db.mjs up",
    "db:down": "node scripts/db.mjs down",
    "db:migrate": "node scripts/db.mjs migrate",
    "db:reset": "node scripts/db.mjs reset",
    "seed:dev": "node scripts/seed-dev.mjs",
    "import:nlem": "node scripts/import-nlem.mjs",
    "medicines:codes": "node scripts/load-medicine-codes.mjs",
    "medicines:translit": "node scripts/load-translit-gu.mjs",
    "medicines:inspect": "node scripts/inspect-nlem.mjs",
    "licences:web": "node scripts/web-licences.mjs",
    "e2e": "node scripts/e2e.mjs",
    "verify:audit": "node scripts/verify-audit-chain.mjs",
    "guard:shell": "node scripts/check-no-shell-scripts.mjs",
    "guard:data": "node scripts/check-no-data-files.mjs",
    "guard:seed": "node --test scripts/seed-sources.test.mjs && node scripts/check-seed-sources.mjs",
    "sbom": "node scripts/sbom.mjs",
    "sbom:reasons": "node scripts/sbom.mjs --reasons-only",
    "dev:api": "npm run dev -w apps/api-node",
    "dev:web": "npm run dev -w apps/web",
    "dev:asr": "node scripts/py.mjs dev",
    "docs:index": "node scripts/py.mjs exec ../../scripts/build_doc_index.py",
    "prd:diff": "node scripts/py.mjs exec ../../scripts/prd_id_diff.py ../../DOCUMENTS/archive/VaaniEHR_PRD_v1.0.md ../../DOCUMENTS/VaaniEHR_PRD.md",
    "stack:up": "node scripts/stack.mjs up",
    "stack:down": "node scripts/stack.mjs down",
    "stack:status": "node scripts/stack.mjs status",
    "fhir:fetch": "node scripts/fhir-fetch.mjs",
    "fhir:validate": "node scripts/fhir-validate.mjs",
    "fhir:check": "node scripts/fhir-golden-check.mjs",
    "fhir:server": "node scripts/fhir-validator-server.mjs"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.12.0",
    "eslint-config-prettier": "10.1.8",
    "globals": "17.13.0",
    "prettier": "3.9.10",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.2"
  }
}
